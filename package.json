{
  "name": "chatgpt-iq-check",
  "private": true,
  "version": "0.1.0",
  "description": "第三方 ChatGPT 降智雷达与分数趋势看板（非官方，AGPL-3.0-or-later）",
  "repository": { "type": "git", "url": "git+https://github.com/dev-of-mc-yzy15/ChatGPT-IQ-Check.git" },
  "author": "dev-of-mc-yzy15",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": { "node": ">=24" },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run typecheck:scripts && vite build",
    "preview": "vite preview",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "refresh": "node scripts/refresh.mjs",
    "check:base": "node scripts/check-base.mjs",
    "verify:assets": "node scripts/verify-assets.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "axe-core": "^4.14.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0",
    "yaml": "^2.8.0"
  }
